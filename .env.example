# Copy to .env and fill in. Every value here is a placeholder.

# Profile: dev, test or prod
SPRING_PROFILES_ACTIVE=dev

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm_dev
DB_USER=crm
DB_PASSWORD=change-me

# Browser origin allowed to call the API
APP_CORS_ORIGINS=http://localhost:5173

# First admin login, created on startup
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Outbound calls to the legacy storefront app
LEGACY_API_REFRESH_TOKEN=change-me
LEGACY_US_API_URL=https://us.storefront.example.internal
LEGACY_DECO_API_URL=https://deco.storefront.example.internal
LEGACY_CA_API_URL=https://ca.storefront.example.internal
LEGACY_AU_API_URL=https://au.storefront.example.internal

# Inbound machine-to-machine calls from the legacy app
CRM_API_REFRESH_TOKEN=change-me
CRM_JWT_SIGNING_KEY=change-me-to-at-least-32-random-characters

# RabbitMQ (mail and chat notifications are published here)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
MAIL_FROM_ADDRESS=noreply@example.com

# Optional
# REPLACEMENT_SHIPPED_MAIL_ENABLED=false
# REPLACEMENT_SHIPPED_MAIL_RECIPIENT_OVERRIDE=qa@example.com
# REPLACEMENT_SHIPPED_MAIL_NOTIFY_BCC=support@example.com
# NOTIFY_REFUND_TICKET_MEMBER=
# GSM_ALARM_GROUP=
# KEYCLOAK_ENABLED=false
# KEYCLOAK_BASE_URL=https://sso.example.internal
# KEYCLOAK_REALM=exampleco
# KEYCLOAK_CLIENT_ID=crm
# KEYCLOAK_CLIENT_SECRET=change-me
